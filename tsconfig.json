{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "geojson",
      "node"
    ]
  },
  "include": [
    "style",
    "viewer"
  ]
}
